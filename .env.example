# ============================================================
#  QUEEN AKUMA V4 — environment variables
#  Copy to .env (never commit .env) or set these in your host's dashboard.
#
#  Deploy with `npm start` (node sessions.js) — a single deployment, no
#  SESSION_ID needed. It opens a pairing page on PORT: enter a WhatsApp
#  number there to get a pairing code. Multiple numbers can be paired
#  from the same deployment (see MAX_SESSIONS below).
# ============================================================

# --- Bot ---
BOT_NAME=QUEEN AKUMA V4
BOT_PREFIX=.
OWNER_NAME=INCONNU BOY SENSEI
PORT=3000
# Legacy: paste a QUEENAKUMAV4:... session string to skip the pairing page
# for a single account (only used by `npm run single` / node index.js).
SESSION_ID=

# --- Wolvarex API (music, AI, fun, uploads, screenshots, weather...) ---
WOLVAREX_API_KEY=your_api_key_here
# WOLVAREX_BASE_URL=https://apix.wolvarex.com/api
# API_TIMEOUT_MS=25000
# DOWNLOAD_TIMEOUT_MS=90000
# API_RETRIES=1

# --- Optional own AI provider keys (tried before Wolvarex for .gpt4/chatbot) ---
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Menu ---
MENU_ADS_ENABLED=true
MENU_ADS_TEXT=Powered by Paxton-Tech
# MENU_IMAGE_URL=

# Repo link shown by .repo, the menu ad card and the contextInfo card on every message.
# REPO_URL=https://akumagen2.vercel.app
# Link card (contextInfo.externalAdReply) on every message. off = channel chip only.
# BOT_CONTEXT_CARD=on

# "Forwarded many times" label on .ping/.runtime/.alive/... replies (cosmetic). off = hide.
# BOT_FORWARDED_TAG=on
# Optional plain-text line above .ping/.runtime results (default: none).
# BOT_NOTICE_LINE=

# Label above the menu ad (change in chat with .adstag).
# MENU_ADS_TAG=📢 ADVERTISEMENT
# WhatsApp-drawn "Ad" badge on the menu message (cosmetic). Link opened by the card:
# MENU_ADS_BADGE=true
# MENU_ADS_URL=

# --- Limits ---
# MAX_AUDIO_MB=40
# MAX_AUDIO_MINUTES=20
# MAX_MEDIA_MB=50
# MAX_UPLOAD_MB=15

# --- Security (all OFF / empty by default) ---
# Comma-separated numbers (digits only) allowed to use the "$" dev shortcut.
DEV_NUMBERS=
# Enables the owner-only .eval command (arbitrary code execution!).
ENABLE_EVAL=false
# GitHub "owner/repo" that .update pulls from. .update is disabled until set.
UPDATE_REPO=
UPDATE_BRANCH=main

# Auto-join the project support group on first connect (OFF unless you opt in).
AUTO_JOIN_GROUP=false

# --- Newsletter / channel auto-react ---
# Comma-separated list of newsletter (channel) JIDs to auto-react to with a
# random emoji on every new post. Defaults to Paxton MD's own update channel
# if left unset. Bare numeric IDs also work — "@newsletter" is appended
# automatically.
# NEWSLETTER_CHANNELS=120363427360133880@newsletter,123456789012345@newsletter

# --- Multi-session (sessions.js — this is what `npm start` runs) ---
# Hard cap on how many WhatsApp numbers this deployment will host at once.
# MAX_SESSIONS=25
# Restricts GET /api/sessions (phone numbers + status of every paired
# session) to callers that pass ?key=<this>. Unset = open to anyone who
# can reach the deployment.
# ADMIN_KEY=
